# Copie ce fichier en `.env` et remplis les valeurs.

# --- Accès à l'application ---
# Mot de passe de connexion (choisis-en un long).
ADMIN_PASSWORD=
# Clé secrète pour signer les sessions : génère-la avec `openssl rand -hex 32`.
SECRET_KEY=
# Mettre true si l'application est servie en HTTPS (recommandé).
COOKIE_SECURE=true
# Adresse publique de l'application (utilisée dans les liens d'acceptation des devis).
PUBLIC_URL=https://factures.mondomaine.fr

# --- Envoi des mails (Gmail) ---
# Crée un « mot de passe d'application » : https://myaccount.google.com/apppasswords
# (la validation en 2 étapes doit être activée sur le compte Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=vieira.ruben.fr@gmail.com
SMTP_PASSWORD=
# Adresse d'expédition (par défaut = SMTP_USER)
SMTP_FROM=
# Recevoir une copie cachée de chaque mail envoyé aux clients.
SMTP_BCC_SELF=true

# --- Tâches automatiques ---
# Heure de génération / envoi des factures récurrentes (heure de Paris).
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
# Nombre de sauvegardes quotidiennes de la base conservées.
BACKUP_KEEP=30

# --- Droits sur le dossier ./data ---
# uid/gid propriétaires des fichiers de ./data (par défaut 1000 = premier utilisateur Linux).
# Vérifie le tien avec la commande `id`.
PUID=1000
PGID=1000
